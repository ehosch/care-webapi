# Used by docker-compose.full.yml — copy to .env.full and fill in your own values.
# Run with: docker compose -f docker-compose.full.yml --env-file .env.full up -d

# --- Domain / URLs — the two most common things to customize ---
# Where the WASM frontend will be reachable from a browser (sets CORS on the API):
WASM_URL=https://care.yourdomain.example
# Where the API will be reachable from the WASM app's browser calls:
API_URL=https://api.yourdomain.example
# Host ports if you're not fronting this with a reverse proxy (defaults: 5010/5011)
API_PORT=5010
WASM_PORT=5011

# --- Database ---
DB_ROOT_PASSWORD=change-me

# --- JWT (required, 32+ characters) ---
JWT_KEY=change-me-to-a-random-32-plus-character-string
REQUIRE_CONFIRMED_ACCOUNT=false

# --- Hangfire dashboard credentials ---
HANGFIRE_PASSWORD=change-me

# --- Mail provider — swap these for whichever SMTP relay/provider you use ---
# Examples: Mailgun (smtp.mailgun.org:587), SendGrid (smtp.sendgrid.net:587),
# your own Postfix/relay (port 25, often no auth needed on a trusted network).
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_FROM=care@yourdomain.example
MAIL_DISPLAY_NAME=Care Coordination
MAIL_USERNAME=
MAIL_PASSWORD=

# --- SMS (Twilio) — optional, leave blank to disable SMS notifications ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
